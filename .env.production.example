# MedVault — Production Environment
# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.production and fill in ALL values before deploying.
# NEVER commit .env.production to git — it contains real secrets.
#
# Generate a secure JWT key:
#   python -c "import secrets; print(secrets.token_hex(64))"
# ─────────────────────────────────────────────────────────────────────────────

# ── Domain (used by nginx template and CORS / TRUSTED_HOSTS in compose) ───────
DOMAIN=your.domain.com

# ── AI ────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=replace_with_64_hex_chars_generated_above
APP_ENV=production
ACCESS_TOKEN_EXPIRE_MINUTES=480
ENABLE_DOCS=false

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=medvault
POSTGRES_USER=medvault
POSTGRES_PASSWORD=replace_with_strong_password
DATABASE_URL=postgresql://medvault:replace_with_strong_password@postgres:5432/medvault

# ── Cache ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_EXACT_CACHE_TTL_SECONDS=3600

# ── Vector DB ─────────────────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333

# ── Checkpoints (LangGraph SQLite) ───────────────────────────────────────────
CHECKPOINTS_DB_URL=checkpoints.db

# ── LangSmith observability (optional but recommended) ───────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=medvault-prod

# ── Google OAuth (optional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your.domain.com/api/v1/auth/google/callback
GOOGLE_OAUTH_ALLOW_INSECURE_HTTP=false

# ── Gunicorn (optional override) ──────────────────────────────────────────────
# Default: min(cpu_count + 1, 4). Lower on RAM-constrained servers (each worker ~1-2 GB).
# GUNICORN_WORKERS=2
